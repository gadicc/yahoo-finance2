  "v1ReviewFinding": {
    "review": {
      "id": "held-stdio-pid-recovery-bypasses-final-cleanup",
      "priority": "P2",
      "file": "scripts/native-platform-process.ts",
      "lines": [
        199,
        205
      ],
      "title": "Keep PID recovery inside unconditional teardown",
      "description": "The outer finally clears emergency then performs existsSync/readFileSync before entering the teardown try/finally. If recovery read raises, forceTree(parent), metadata retention, stream destruction and parent.unref are skipped. The parent is still live because observer release has not occurred.",
      "reproduction": "After both actual inherited-pipe handshakes, chmod the private PID file unreadable and attempt the original read. Normal and recovery reads raise real EACCES. With the actual frozen finalization unchanged, Bun exits1, no metadata is written and both real parent/descendant remain live; independent supervisor kills/reaps the known processes.",
      "scopeLimit": "An induced local file-read failure; normal trusted private permissions ordinarily allow this read. This is failure-path cleanup robustness, not a normal-run failure or hostile-input/actual-Windows exploit.",
      "requiredFix": "Put PID recovery inside a try whose finally always attempts parent-tree cleanup. Make destroy/unref unconditional even if recovery, killing or metadata writing fails. Add an actual PID-read-error cleanup control while keeping original error visible."
    },
    "originalFailureProof": {
      "case": "unreadable-pid-file",
      "exitCode": 1,
      "supervisorTimeout": false,
      "metadataPresent": false,
      "parentPID": 33,
      "descendantPID": 40,
      "parentLiveAfterFailure": true,
      "descendantLiveAfterFailure": true,
      "actualReadFailure": true,
      "supervisorCleanedAllKnownPIDs": true
    },
    "resolution": "PID recovery is inside the teardown try/finally, so read failures still attempt parent-tree termination. Stream destroy/unref calls are in nested innermost finally clauses, independent of PID recovery, forceTree or metadata write failures. Existing Windows topology/handshake/post-exit and cleanup-uncertainty assertions remain."
  },
