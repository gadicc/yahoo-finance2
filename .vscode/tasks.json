{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "schema watch",
      "command": "bun",
      "args": ["run", "schema", "--watch"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "type": "process",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "owner": "schema",
        "pattern": {
          "regexp": "^(?:\\* .*?: |Error: )?([^\\s].*?)[(:](\\d+)[,:](\\d+)(?:\\):\\s+|\\s+-\\s+)(error|warning|info)\\s+TS(\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Schema scan started\\.$",
          "endsPattern": "^Schema (?:scan complete; watching\\.|generation failed; still watching(?:\\.|:.*))$"
        },
        "source": "schema",
        "fileLocation": ["relative", "${workspaceFolder}"]
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
